# Copy to .env (git-ignored) or export in your shell. NEVER commit real keys.
# Everything runs offline with the mock backend if you set nothing at all.

# --- LLM provider (OpenAI-compatible). For OpenRouter: ---
OPENAI_API_KEY=your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For OpenAI directly, drop OPENAI_BASE_URL and use plain model ids.

# --- Jev router (optional; without it --router jev falls back to the heuristic) ---
TYPESAFE_API_KEY=your-typesafe-key-here

# --- G6 Unit settings (all optional; CLI flags override) ---
MINICODEX_BACKEND=mock                  # mock (offline) or openai
MINICODEX_MODEL=openai/gpt-6.1-sol      # model when not routing
MINICODEX_MAX_ITERATIONS=6              # edit-and-test attempts per task
MINICODEX_REASONING_EFFORT=low          # reasoning effort for reasoning models
# MINICODEX_INPUT_COST_PER_M=2.00       # USD per 1M tokens; only used when the
# MINICODEX_OUTPUT_COST_PER_M=10.00     # provider does not report cost itself
